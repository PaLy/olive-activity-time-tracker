{
  "name": "olive-activity-time-tracker",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "animejs": "^4.5.0",
    "console-feed": "^3.8.0",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.7",
    "dexie-export-import": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "file-saver": "^2.0.5",
    "humanize-duration": "^3.35.0",
    "immer": "^11.2.9",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-flip-toolkit": "^7.2.4",
    "react-router": "^8.5.1",
    "react-window": "^2.5.2",
    "recharts": "^3.10.1",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/animejs": "^4.0.0",
    "@types/css-mediaquery": "^0.1.4",
    "@types/file-saver": "^2.0.7",
    "@types/humanize-duration": "^3.27.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "blob-polyfill": "^9.0.20240710",
    "css-mediaquery": "^0.1.2",
    "fake-indexeddb": "^6.2.7",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "mockdate": "^3.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "predeploy-to-gh": "PUBLIC_URL=https://paly.github.io/olive-activity-time-tracker npm run build",
    "deploy-to-gh": "gh-pages -d dist",
    "predeploy-to-android": "npm run build",
    "deploy-to-android": "rm -rf android/app/src/main/assets/www && mv dist android/app/src/main/assets/www",
    "test": "vitest",
    "test-coverage": "vitest run --coverage",
    "upgrade-interactive": "npx npm-check-updates --interactive",
    "upgrade": "npx npm-check-updates -u --target minor",
    "npm-audit-fix": "npm audit fix",
    "format": "oxfmt --write .",
    "lint": "oxlint src",
    "patch-vite-plugin-checker": "npx patch-package vite-plugin-checker",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "npx oxlint --fix",
      "npx oxfmt --write"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
